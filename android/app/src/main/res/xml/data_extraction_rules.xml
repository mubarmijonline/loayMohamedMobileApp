<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules. Everything is excluded: the app holds
  session tokens and cached lesson metadata, none of which should survive into
  a cloud backup or a device-to-device transfer.

  Paired with android:allowBackup="false" for pre-12 devices.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

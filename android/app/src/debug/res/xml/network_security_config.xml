<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG ONLY. Overrides the release config so a local proxy can be used while
  developing. This file is never part of a release build — it lives under
  src/debug and the manifest merger substitutes it only for that variant.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
</network-security-config>
